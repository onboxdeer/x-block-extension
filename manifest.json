{
  "manifest_version": 3,
  "name": "X/Twitter 评论一键拉黑助手",
  "version": "3.0.0",
  "description": "扫描 X 帖子评论，按自定义关键词筛选并一键拉黑命中账号。仅网页端、纯本地处理、不上传任何数据。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "X 评论拉黑助手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
